# kumero – Signierdienst / Sicherheitsmodul (F15, F22, F23)
# Von install.sh angelegt, aber erst aktivieren, wenn /usr/lib/kumero-ssm/kumero-ssm
# ausgeliefert ist:  systemctl enable --now kumero-ssm
#
# Die Passphrase des Signier-Unterschlüssels wird über systemd-creds
# verschlüsselt bereitgestellt (optional an TPM2 gebunden):
#   systemd-creds encrypt --name=passphrase - /etc/kumero-ssm/passphrase.cred

[Unit]
Description=kumero Signierdienst (Sicherheitsmodul)
After=network.target
ConditionPathExists=/usr/lib/kumero-ssm/kumero-ssm

[Service]
Type=simple
User=kumero-ssm
Group=kumero-ssm
ExecStart=/usr/lib/kumero-ssm/kumero-ssm --socket /run/kumero-ssm/ssm.sock
Environment=GNUPGHOME=/var/lib/kumero-ssm/gnupg
LoadCredentialEncrypted=passphrase:/etc/kumero-ssm/passphrase.cred

RuntimeDirectory=kumero-ssm
RuntimeDirectoryMode=0750
UMask=0007
# Socket für die Gruppe kumero-ssm-client (Anwendung) zugänglich
SupplementaryGroups=kumero-ssm-client

# Härtung
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
ReadWritePaths=/var/lib/kumero-ssm
# Nur Unix-Socket lokal und HTTPS zum Zeitstempeldienst
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
