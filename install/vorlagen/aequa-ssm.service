# Aequa – Signierdienst / Sicherheitsmodul (F15, F22, F23)
# Von install.sh angelegt, aber erst aktivieren, wenn /usr/lib/aequa-ssm/aequa-ssm
# ausgeliefert ist:  systemctl enable --now aequa-ssm
#
# Die Passphrase des Signier-Unterschlüssels wird über systemd-creds
# verschlüsselt bereitgestellt (optional an TPM2 gebunden):
#   systemd-creds encrypt --name=passphrase - /etc/aequa-ssm/passphrase.cred

[Unit]
Description=Aequa Signierdienst (Sicherheitsmodul)
After=network.target
ConditionPathExists=/usr/lib/aequa-ssm/aequa-ssm

[Service]
Type=simple
User=aequa-ssm
Group=aequa-ssm
ExecStart=/usr/lib/aequa-ssm/aequa-ssm --socket /run/aequa-ssm/ssm.sock
Environment=GNUPGHOME=/var/lib/aequa-ssm/gnupg
LoadCredentialEncrypted=passphrase:/etc/aequa-ssm/passphrase.cred

RuntimeDirectory=aequa-ssm
RuntimeDirectoryMode=0750
UMask=0007
# Socket für die Gruppe aequa-ssm-client (Anwendung) zugänglich
SupplementaryGroups=aequa-ssm-client

# Härtung
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
ReadWritePaths=/var/lib/aequa-ssm
# Nur Unix-Socket lokal und HTTPS zum Zeitstempeldienst
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
